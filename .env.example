# Copia este archivo a .env y llena solo lo que vayas a usar.
# El .env nunca se versiona. En Render estas variables van en el dashboard
# del servicio, no en el repo.

# --- Cerebro (P2) --------------------------------------------------------
# Sin esta clave el pipeline no falla: cae a datos mock y el playbook sale
# determinista, correcto en los datos pero sin narración.
ANTHROPIC_API_KEY=

# --- Backend y base de datos (P3) ---------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Salta todas las reglas de acceso: solo en el servidor, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingesta (P1) --------------------------------------------------------
# La CLI de ingesta carga .env sola. Las variables exportadas en el shell mandan.
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
GOOGLE_DRIVE_TOKEN=
