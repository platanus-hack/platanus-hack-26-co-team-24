# Copia este archivo a .env y llena solo lo que vayas a usar.
# El .env nunca se versiona. En Render estas variables van en el dashboard
# del servicio, no en el repo.

# --- Cerebro (P2) --------------------------------------------------------
# Sin esta clave el pipeline no falla: cae a datos mock y el playbook sale
# determinista, correcto en los datos pero sin narración.
ANTHROPIC_API_KEY=

# --- Backend y base de datos (P3) ---------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Salta todas las reglas de acceso: solo en el servidor, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Entrar con Google (P3) ----------------------------------------------
# Se entra solo con Google y solo con correos de este dominio. Los pasos para
# habilitar el provider en Supabase y en Google Cloud están en
# backend/README.md -> "Entrar". Sin esta variable el default es inerxia.co.
DOMINIO_PERMITIDO=inerxia.co

# --- OAuth de Slack (P3) -------------------------------------------------
# Los pasos exactos para crear la app están en backend/README.md → "Conectar
# Slack". Sin estas tres, los endpoints de /conexiones/slack responden 503
# diciendo cuál falta, no un 500 opaco.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Tiene que coincidir carácter por carácter con la Redirect URL registrada en
# api.slack.com, o Slack responde bad_redirect_uri al canjear el código.
SLACK_REDIRECT_URI=http://localhost:8000/conexiones/slack/callback
# A dónde vuelve el navegador tras aprobar la app (Slack y Google), y el único
# origen que acepta CORS.
FRONTEND_URL=http://localhost:5173
# Opcional. Si se pone, POST /admin/eventos exige la cabecera X-Admin-Token.
ADMIN_TOKEN=

# --- Ingesta (P1) --------------------------------------------------------
# La CLI de ingesta carga .env sola. Las variables exportadas en el shell mandan.
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
GOOGLE_DRIVE_TOKEN=
